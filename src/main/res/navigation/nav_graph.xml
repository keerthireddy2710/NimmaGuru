<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.nimmaguru.ui.auth.LoginFragment"
        android:label="Login">
        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.nimmaguru.ui.home.HomeFragment"
        android:label="Home">
        <action
            android:id="@+id/action_home_to_profile"
            app:destination="@id/guruProfileFragment" />
        <action
            android:id="@+id/action_home_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.nimmaguru.ui.search.SearchFragment"
        android:label="Search" />

    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.example.nimmaguru.ui.calendar.CalendarFragment"
        android:label="Calendar" />

    <fragment
        android:id="@+id/wallOfFameFragment"
        android:name="com.example.nimmaguru.ui.walloffame.WallOfFameFragment"
        android:label="Wall of Fame" />

    <fragment
        android:id="@+id/guruProfileFragment"
        android:name="com.example.nimmaguru.ui.profile.GuruProfileFragment"
        android:label="Guru Profile" />

</navigation>