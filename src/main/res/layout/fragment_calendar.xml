<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/surface">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/upcoming_sessions"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_add_session"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_session"
            android:textSize="14sp"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_sessions"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/tv_empty_sessions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No upcoming sessions.\nBe the first to add one! 📅"
        android:textSize="16sp"
        android:textColor="#888"
        android:gravity="center"
        android:padding="40dp"
        android:visibility="gone" />

</LinearLayout>